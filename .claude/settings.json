{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(scripts/**)",
      "Edit(docs/**)",
      "Edit(planning/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git rev-list*)",
      "Bash(git branch --list*)",
      "Bash(git grep*)",
      "Bash(ls*)",
      "Bash(wc*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(du*)",
      "Bash(file*)",
      "Bash(powershell.exe -NoProfile -File scripts/develop.ps1*)",
      "Bash(powershell.exe -NoProfile -File scripts/test-*)",
      "Bash(powershell.exe -NoProfile -File scripts/check-vba-source.ps1*)",
      "Bash(powershell.exe -NoProfile -File scripts/verify-build-artifact.ps1*)",
      "PowerShell(powershell.exe -NoProfile -File scripts/develop.ps1*)",
      "PowerShell(powershell.exe -NoProfile -File scripts/test-*)",
      "PowerShell(powershell.exe -NoProfile -File scripts/check-vba-source.ps1*)",
      "PowerShell(powershell.exe -NoProfile -File scripts/verify-build-artifact.ps1*)",
      "PowerShell(Get-Process MSACCESS*)"
    ],
    "deny": [
      "Edit(output/**)",
      "Edit(FORMS_REFERENCES_TEMPLATES/**)",
      "Edit(NAVFIT98A/**)",
      "Edit(NAVFIT98A_v33p2_Upgrade_Tool/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/vba-check.ps1\"",
            "timeout": 60,
            "statusMessage": "Checking VBA source"
          }
        ]
      }
    ]
  }
}
