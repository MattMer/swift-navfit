Public Function BlockExampleCount(ByVal key As String, ByVal kind As String) As Long
    BlockExampleCount = UBound(Examples(key, kind)) + 1
End Function

Public Function BlockExample(ByVal key As String, ByVal kind As String, ByVal index As Long, ByVal part As Long) As String
    BlockExample = Examples(key, kind)(index)(part)
End Function

' Every field key that has examples, separated by commas, for tests.
Public Function BlockExampleKeys() As String
    Dim t As String
    t = t & "OfficialName,MemberLastName,MemberFirstName,MemberMiddleInitial,MemberSuffix,RankRate,Designator,MemberSSN"
    t = t & ",MemberDoDID,UnitUIC,ShipStation,DateReported,PeriodStart,PeriodEnd,ReadinessSummary,ReadinessDate"
    t = t & ",BilletSubcategory,ReportingSeniorName,ReportingSeniorLastName,ReportingSeniorFirstInitial,ReportingSeniorMiddleInitial,ReportingSeniorGrade,ReportingSeniorDesignator,ReportingSeniorTitle"
    t = t & ",ReportingSeniorUIC,ReportingSeniorSSN,ReportingSeniorDoDID,CommandEmployment,PrimaryDuty,DutyDescription,CounselingDate,CounselorName"
    t = t & ",CounselorLastName,CounselorFirstInitial,CounselorMiddleInitial,AssignmentRecommendationA,AssignmentRecommendationB,OfficialComments,Qualifications,ReportingSeniorAddress1"
    t = t & ",ReportingSeniorAddress2,ReportingSeniorCity,ReportingSeniorState,ReportingSeniorZip,ReportingSeniorPhone,ReportingSeniorDSN,RaterName,RaterDate"
    t = t & ",SeniorRaterName,SeniorRaterDate,Trait33Comment1,Trait33Comment2,Trait33Comment3,Trait34Comment1,Trait34Comment2,Trait34Comment3"
    t = t & ",Trait35Comment1,Trait35Comment2,Trait35Comment3,Trait36Comment1,Trait36Comment2,Trait36Comment3,Trait37Comment1,Trait37Comment2"
    t = t & ",Trait37Comment3,Trait38Comment1,Trait38Comment2,Trait38Comment3,Trait39Comment1,Trait39Comment2,Trait39Comment3"
    BlockExampleKeys = t
End Function
