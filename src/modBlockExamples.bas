    Case "OfficialComments"
        Select Case kind
        Case "EVAL"
            Examples = Array(Array("TOP PERFORMER - MY #1 OF 14 FIRST CLASS PETTY OFFICERS!", "Open with the ranking or the reason for a Special report.", "Swift", ""), Array("-Led 6 Sailors processing 1,200 personnel actions with zero errors.", "Action, scope and result. See chapter 13 for what must and must not be said.", "Swift", ""))
        Case "CHIEFEVAL"
            Examples = Array(Array("MY #1 OF 6 CHIEFS. Selfless leader who builds the next generation of Chiefs.", "Open with the ranking or the reason for a Special report.", "Swift", ""), Array("-Mentored 9 First Class Petty Officers; 4 advanced to Chief.", "See chapter 13 for what must and must not be said.", "Swift", ""))
        Case "FITREP"
            Examples = Array(Array("MY #1 OF 5 LIEUTENANTS. Ready for department head now.", "Open with the ranking or the reason for a Special report.", "Swift", ""), Array("-Led 40 Sailors through a 6-month deployment with zero mishaps.", "See chapter 13 for what must and must not be said.", "Swift", ""))
