        Case Else
            Examples = Array(Array("USS EXAMPLE DDG 1", "Abbreviated activity name. Use 1, not ONE.", "Swift", ""), Array("NAVSTA EXAMPLE", "", "Swift", ""))
        End Select
    Case "DateReported"
        Select Case kind
        Case Else
            Examples = Array(Array("2026-03-16", "The date the member reported to the block 7 command. It prints as 26MAR16.", "Swift", ""))
        End Select
    Case "PeriodStart"
        Select Case kind
        Case Else
