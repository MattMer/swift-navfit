    Select Case key
    Case "OfficialName"
        Select Case kind
        Case Else
            Examples = Array(Array("Denney, John A", "Last name, comma, first name, middle initial.", "EVALMAN", "Block 1:"), Array("STJohn, Melvin J II", "No spaces or punctuation inside a name. A suffix goes last.", "EVALMAN", "Block 1:"))
        End Select
    Case "MemberLastName"
        Select Case kind
        Case Else
            Examples = Array(Array("SmithJones", "No spaces or punctuation inside the name.", "Swift", ""))
        End Select
    Case "MemberFirstName"
        Select Case kind
        Case Else
            Examples = Array(Array("Ann", "", "Swift", ""))
        End Select
    Case "MemberMiddleInitial"
        Select Case kind
        Case Else
            Examples = Array(Array("S", "NMN when there is no middle name.", "Swift", ""))
        End Select
    Case "MemberSuffix"
        Select Case kind
        Case Else
            Examples = Array(Array("JR", "", "Swift", ""), Array("II", "", "Swift", ""))
        End Select
    Case "RankRate"
        Select Case kind
        Case "EVAL"
            Examples = Array(Array("CS2", "The rate worn on the report's end date.", "EVALMAN", "Block 2:"), Array("BM1", "", "EVALMAN", "Block 2:"))
        Case "CHIEFEVAL"
            Examples = Array(Array("EMCS", "The rate worn on the report's end date.", "EVALMAN", "Block 2:"), Array("PSCM", "", "EVALMAN", "Block 2:"))
        Case "FITREP"
