        Case "EVAL"
            Examples = Array(Array("AW/PJ", "Up to two warfare designators, slash, no spaces. Blank if none.", "EVALMAN", "Block 3:"))
        Case "CHIEFEVAL"
            Examples = Array(Array("SS/DV", "Up to two warfare designators, slash, no spaces. Blank if none.", "EVALMAN", "Block 3:"))
        Case "FITREP"
            Examples = Array(Array("1110", "The four-digit designator on the report's end date.", "Swift", ""), Array("6410", "", "Swift", ""))
        End Select
    Case "MemberSSN"
        Select Case kind
        Case Else
            Examples = Array(Array("000000000", "Type the 9 digits. The report prints them as 000-00-0000.", "Swift", ""))
        End Select
    Case "MemberDoDID"
        Select Case kind
        Case Else
