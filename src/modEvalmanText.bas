t = t & "[Page 9-1]"
t = t & vbCrLf
t = t & vbCrLf
t = t & "9-1. Purpose. This chapter provides information needed to prepare FITREPS, CHIEFEVALs and EVALs on members of the Navy Reserve in what is commonly known as drilling status, but officially termed In-Active Duty Navy Reservists - Members who are Selected Reservists, reservists assigned to a voluntary training unit (VTU), or Stand-by Reserve-Active (USNR-S1) members as defined by reference (f); eligible for promotion or advancement; or serving on paid or unpaid inactive duty for training (IDT) orders (also known as drill orders. See chapter 10 for reports on reservists assigned to ACDU commands."
T0204 = t
End Function
Private Function T0205() As String
Dim t As String
t = t & "[Page 9-1]"
t = t & vbCrLf
t = t & vbCrLf
t = t & "9-2. Definitions. The terms below are provided to ensure proper application of this chapter. For details on reserve status, refer to figure 1-1 in reference (f)."
t = t & vbCrLf
t = t & vbCrLf
t = t & "a. In Assignment Processing (IAP) - A holding status for drilling reservists awaiting assignment to an authorized billet."
t = t & vbCrLf
t = t & vbCrLf
t = t & "b. Reserve Unit Identification Code (RUIC) - A five-digit code used to identify a Reserve unit."
t = t & vbCrLf
t = t & vbCrLf
t = t & "c. Training Unit Identification Code (TRUIC) - The local Reserve unit wherein a reservist trains, but is not necessarily billeted (i.e., member can be IAP or hold a billet via a crossassignment)."
t = t & vbCrLf
t = t & vbCrLf
t = t & "d. Unit Mobilization Unit Identification Code (UMUIC) - The unit wherein a reservist is billeted, holds a mobilization assignment, conducts monthly Inactive-Duty (INACT) Training Drills if locally assigned or at a minimum, quarterly drills if not locally assigned."
t = t & vbCrLf
t = t & vbCrLf
t = t & "e. Cross-Assignment - An assignment where a reservist is administratively assigned to a local training unit, as well as assigned operationally to another. A cross-assigned Sailor is cross assigned out (CAO) from the local TRUIC unit and cross-assigned in (CAI) to the UMUIC unit where the mobilization billet resides. Cross-assigned Sailors have two chains of command, the administrative (via the TRUIC) and the operational (via the UMUIC). Effective management of cross-assigned Sailors require constant and proactive communications."
t = t & vbCrLf
t = t & vbCrLf
t = t & "f. AUIC - The active-duty unit that is supported by the UMUIC and owns the Reserve billet to which members are actually assigned, regardless of the members' local or cross-assignment status. The AUIC is normally where the reservists perform their AT or 2 weeks of ACDU."
t = t & vbCrLf
t = t & vbCrLf
t = t & "g. VTU - A TRUIC for non-billeted reservists who earn retirement points for non-paid drills and may occasionally perform paid ADT or ADOS."
t = t & vbCrLf
t = t & vbCrLf
t = t & "[Page 9-2]"
t = t & vbCrLf
t = t & vbCrLf
t = t & "h. USNR-S1 - Reservists that participate in non-paid training per SECNAVINST 1001.32D. Any drills and or ADT must be performed in a non-pay status."
T0205 = t
End Function
Private Function T0206() As String
