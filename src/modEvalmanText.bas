Private Function T0256() As String
Dim t As String
t = t & "[Page 13-1]"
t = t & vbCrLf
t = t & vbCrLf
t = t & "13-2. Technical Aspects"
t = t & vbCrLf
t = t & "a. Typography and Style"
t = t & vbCrLf
t = t & vbCrLf
t = t & "(1) NAVFIT98A reports with 10- or 12-pitch will still be accepted."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(2) Be concise. Comment space is very limited. Bullet style is preferred; do not use distracting or irrelevant comments."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(3) Be consistent. Be consistent between performance trait marks, comments, and summary group breakdown."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(4) Use everyday language. Do not use flowery adjectives or other extremes of style. Let the member's performance speak louder than words."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(5) Give examples of performance and results. Be specific. Concentrate on verifiable accomplishments that are measurable."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(6) Quantify. Give credibility to the statements wherever possible, but do not stress quantity at the expense of quality."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(7) Do not make everyone sound alike. Selection boards may discount narratives assembled from a list of stock comments used for everyone in the command."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(8) Do not combine outstanding comments with average or below average marks (or the reverse). This makes the entire report unconvincing."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(9) Ranking. Ranking in the comments field is authorized."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(10) Clarity. The report must be understandable by all readers, both now and in the future. Limit the use of acronyms or command specific terms."
t = t & vbCrLf
t = t & vbCrLf
t = t & "b. Continuations, Attachments, and Enclosures"
t = t & vbCrLf
t = t & vbCrLf
t = t & "[Page 13-2]"
t = t & vbCrLf
t = t & vbCrLf
t = t & "(1) Continuation sheets will not be accepted. Limit comments to the space on the form."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(2) Do not attach or enclose documents, except an endorsed statement submitted by the member, a flag officer endorsement (where required), a civilian or foreign letter report, a letterextension of a Concurrent/Regular report, or a classified letter-supplement, as described below."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(3) Do not enclose citations or commendations."
t = t & vbCrLf
t = t & vbCrLf
t = t & "c. Classification"
t = t & vbCrLf
t = t & vbCrLf
t = t & "(1) Under no circumstances may the report form be classified."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(2) If classified comments are unavoidable, prepare a 1-page letter-supplement classified no higher than SECRET. Do not include special access material."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(3) The combined length of classified and unclassified comments should not exceed the space normally available on the form."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(4) Do not submit classified comments merely to explain the command's mission."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(5) Mail the report and classified supplement together as classified matter, per SECNAVINST 5510.36B."
t = t & vbCrLf
t = t & vbCrLf
t = t & "(6) The mailing address for classified comments is provided in chapter 1, subparagraph 1-6b(2). Note at the end of the comments block that a classified supplement has been submitted."
T0256 = t
End Function
