t = t & vbCrLf
t = t & vbCrLf
t = t & "6. Review, Change, or Endorsement of Reports. The contents of a FITREP, CHIEFEVAL, or EVAL are the responsibility of the reporting senior who signs it, and are not subject to review, change, comment, or endorsement by other persons within or outside the chain of command, except as provided in this manual."
t = t & vbCrLf
t = t & vbCrLf
t = t & "[Page I-3]"
